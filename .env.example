# LLM parsing, ranking and ambiguous dedup.
# LLM_MODEL automatically selects the provider:
#   gpt-* / o1 / o3 / o4 -> OpenAI
#   claude-*             -> Anthropic
#   gemini-*             -> Gemini
#   provider/model       -> OpenRouter (when OPENROUTER_API_KEY is set)
LLM_MODEL=gpt-4o-mini

# Configure the key matching LLM_MODEL (only one is required).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Generic OpenAI-compatible endpoint (optional).
# Set all four values when using another compatible provider.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=

# Optional OpenRouter attribution.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=DataScout AI

# Optional: Kaggle verified adapter
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional catch-all web search: configure one provider
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Frontend origins allowed to call the REST API, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
